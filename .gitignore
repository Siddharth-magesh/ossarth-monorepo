# ==========================================
# OSSARTH Custom Monorepo .gitignore
# ==========================================

# 1. Local AI Models & Weights (CRITICAL)
# Do not commit massive LLM files to GitHub
*.gguf
*.bin
*.pt
*.safetensors
models/
weights/

# 2. Python / MAS Core
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# 3. Systems / Rust / C++ (If used for MCP/OS integration)
target/
*.o
*.so
*.out
build/

# 4. OS Customization & VM Images
*.iso
*.img
*.vdi
*.qcow2

# 5. Logs & Benchmarks
*.log
benchmarks/results/*.csv

# 6. IDEs & OS Junk
.vscode/
.idea/
.DS_Store
Thumbs.db
